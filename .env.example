# Persönlicher API-Key von https://api-manager.opentransportdata.swiss
# (Dataset "Verkehrszähler" / TDP Soap_Datex2). Nie committen oder ins Frontend geben.
OTD_API_KEY=

# Alles ab hier ist optional. Die Werte sind die Standardwerte.

# Netzwerk
# Adresse, auf der der Server lauscht. 127.0.0.1 = nur lokal; im Produktivbetrieb 0.0.0.0.
# HOST=127.0.0.1
# Port des Servers. In der Entwicklung läuft das Frontend separat auf :5173.
# PORT=3000

# Abruf bei opentransportdata.swiss (Zeiten in Millisekunden, ganze Zahlen > 0)
# Abstand der Messwert-Abrufe. Die Daten erscheinen nur minütlich, kürzer bringt nichts.
# Das Rate-Limit liegt bei 5 Abrufen pro Minute und Key.
# MEASUREMENT_INTERVAL_MS=60000
# Zeitpunkt der Abrufe nach der vollen Minute. opentransportdata.swiss veröffentlicht rund
# 20 s nach der vollen Minute (UTC); 25000 holt die Daten kurz danach.
# MEASUREMENT_OFFSET_MS=25000
# Abstand der Abrufe der Messstellentabelle (Standard 6 Stunden). Eine neue Version in den
# Messwerten löst den Abruf zusätzlich sofort aus.
# SITE_TABLE_INTERVAL_MS=21600000
# SOAP-Endpunkt der API, nur für Tests mit einem anderen Ziel ändern. Kein «/» am Ende.
# OTD_ENDPOINT=https://api.opentransportdata.swiss/TDP/Soap_Datex2/Pull

# Dateien und Ordner (am besten absolute Pfade; die Beispiele zeigen den Standardort im Repository)
# Letzte API-Antworten. Ein Neustart nutzt sie weiter, ohne das Rate-Limit zu belasten.
# Im Produktivbetrieb auf einem persistenten Volume halten.
# CACHE_DIR=server/.cache
# Ortsverzeichnis (TMC) für Zählstellen ohne exakten Sensorstandort.
# TMC_FILE=server/data/tmc-locations.json
# Exakte Sensorstandorte der ASTRA-Zählstellen.
# SENSORS_FILE=server/data/astra-sensors.json
# Gebautes Frontend (npm run build), das der Server im Produktivbetrieb ausliefert.
# STATIC_DIR=web/dist
